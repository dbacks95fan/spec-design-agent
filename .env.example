# Reference template only. Keep the actual file outside this repository at
# C:/Repos/.config/spec-design-agent/runtime.env.

# Which generator implementation to use: claude | codex | mock
# codex calls the OpenAI Responses API directly with OPENAI_API_KEY; no CLI is involved.
SPEC_AGENT_PROVIDER=codex
# Optional model id override for the chosen provider (codex default: gpt-6.1-sol).
SPEC_AGENT_MODEL=
# Optional OpenAI reasoning effort for codex (for example low, medium, high); the API default applies when unset.
# SPEC_AGENT_REASONING_EFFORT=
# Wall-clock budget for a single generation call, in milliseconds.
SPEC_AGENT_TIMEOUT_MS=600000

# Provider credentials — supply only the one matching SPEC_AGENT_PROVIDER.
# ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
# OPENAI_API_KEY=replace-with-an-openai-api-key

# Short-lived GitHub App installation token for the assigned product repository.
# SPEC_AGENT_GITHUB_TOKEN=

# Operator check manifest shared with the Coding Agent (coding-agent/config/manifest.json).
# The Work Contract's required_validation is exactly this file's checks for the target repository.
# SPEC_AGENT_CHECK_MANIFEST=/config/check-manifest.json

# Bounded repository inspection (optional; sensible defaults apply).
# SPEC_AGENT_MAX_FILES=4000
# SPEC_AGENT_MAX_BYTES_PER_FILE=65536
# SPEC_AGENT_MAX_DEPTH=6
# SPEC_AGENT_INSPECT_DEADLINE_MS=20000

# Host path to the isolated work-item workspace mounted at /work.
SPEC_AGENT_WORKSPACE=./workspace
