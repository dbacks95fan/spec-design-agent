{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dbacks95fan/spec-design-agent/schemas/spec-run.schema.json",
  "title": "Spec & Design Agent run record",
  "description": "Sanitized provenance record written to .agent/work/<work-item>/spec-run.json. Never contains secrets, credentials, or private model reasoning.",
  "type": "object",
  "required": [
    "runId",
    "workItem",
    "productId",
    "intentCommit",
    "frozenArtifactSha256",
    "intentContentSha256",
    "baseCommit",
    "branch",
    "modelProvider",
    "model",
    "agentVersion",
    "promptVersion",
    "policyVersions",
    "startedAt",
    "completedAt",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "workItem": {
      "type": "string",
      "minLength": 1
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "intentCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "frozenArtifactSha256": {
      "description": "Raw-byte hash of the frozen intent.md this run verified.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intentContentSha256": {
      "description": "Normalized content hash carried from the freeze tuple as provenance.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "modelProvider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "agentVersion": {
      "type": "string",
      "minLength": 1
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "policyVersions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "completedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "spec_ready",
        "needs_decision",
        "blocked",
        "failed"
      ]
    },
    "specVersion": {
      "type": "integer",
      "minimum": 1
    },
    "usage": {
      "description": "Token and cost totals for the generation. Absent when the provider does not report usage (for example the deterministic mock provider).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheCreationTokens",
        "totalTokens",
        "turns"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheReadTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheCreationTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "description": "Provider-reported cost in USD, when available.",
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
