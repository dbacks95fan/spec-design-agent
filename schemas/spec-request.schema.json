{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dbacks95fan/spec-design-agent/schemas/spec-request.schema.json",
  "title": "Spec & Design Agent work request",
  "description": "Agent-specific adapter for an Agentic SDLC StageInvocation 1.1. The Prioritized freeze record is authoritative for frozen intent and policy-profile references.",
  "type": "object",
  "required": ["requestVersion", "runId", "invocationId", "triggerEventId", "stage", "workItem", "productId", "freezeActivation", "target", "readPaths", "writePaths"],
  "additionalProperties": false,
  "properties": {
    "requestVersion": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "invocationId": { "type": "string", "minLength": 1 },
    "triggerEventId": { "type": "string", "minLength": 1 },
    "stage": { "const": "spec_design" },
    "workItem": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)+$" },
    "productId": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
    "intentContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Optional normalized-rendering provenance supplied by the intent source; the raw-byte ArtifactRef fingerprint remains authoritative." },
    "freezeActivation": {
      "type": "object",
      "required": ["schema_version", "event_id", "event_type", "work_item", "intent", "policy_profile_id", "policy_profile_version", "policy_profile", "authorized_by", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0" },
        "event_id": { "type": "string", "minLength": 1 },
        "event_type": { "const": "activated" },
        "work_item": {
          "type": "object",
          "required": ["product_id", "intent_id", "intent_version", "trello_card_id"],
          "additionalProperties": false,
          "properties": {
            "product_id": { "type": "string", "minLength": 1 },
            "intent_id": { "type": "string", "minLength": 1 },
            "intent_version": { "type": "integer", "minimum": 1 },
            "trello_card_id": { "type": "string", "minLength": 1 }
          }
        },
        "intent": { "$ref": "#/$defs/artifactRef" },
        "policy_profile_id": { "type": "string", "minLength": 1 },
        "policy_profile_version": { "type": "string", "minLength": 1 },
        "policy_profile": { "$ref": "#/$defs/artifactRef" },
        "authorized_by": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "target": {
      "type": "object",
      "required": ["repository", "baseCommit", "branch", "workspace"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "branch": { "type": "string", "minLength": 1 },
        "workspace": { "type": "string", "minLength": 1 }
      }
    },
    "readPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "writePaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["repository", "commit_sha", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
